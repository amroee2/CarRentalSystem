@using Microsoft.AspNetCore.Identity
@model CarRentalSystem.Models.Car
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<div class="col-md-4 mb-4">
    <div class="card h-100 shadow-sm">
        <img src="@Model.CarImage" class="card-img-top" alt="@Model.CarName" style="height: 200px; object-fit: cover;">
        <div class="card-body">
            <a asp-controller="Car" asp-action="Details" asp-route-id="@Model.CarId">
                <h5 class="card-title">@Model.CarName</h5>
            </a>
            <p class="card-text">
                <strong>Model:</strong> @Model.CarModel <br />
                <strong>Price/Day:</strong> $@Model.RentPricePerDay <br />
                <strong>Description:</strong> @Model.CarDescription
            </p>
            <p>
                <strong>Availability:</strong>
                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success">Available</span>
                }
                else
                {
                    <span class="badge bg-danger">Not Available</span>
                }
            </p>
            @if(User.IsInRole("Admin"))
            {
                <div class="text-center">
                    <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#updateModal-@Model.CarId">
                        Update
                    </button>
                    <form asp-controller="Car" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this car?');" style="display:inline;">
                        <input type="hidden" name="id" value="@Model.CarId" />
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="updateModal-@Model.CarId" tabindex="-1" aria-labelledby="updateModalLabel-@Model.CarId" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateModalLabel-@Model.CarId">Update Car</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-controller="Car" asp-action="Update" method="post">
                    <input type="hidden" name="CarId" value="@Model.CarId" />
                    <div class="mb-3">
                        <label for="carName-@Model.CarId" class="form-label">Car Name</label>
                        <input type="text" class="form-control" id="carName-@Model.CarId" name="CarName" value="@Model.CarName" required />
                    </div>

                    <div class="mb-3">
                        <label for="carModel-@Model.CarId" class="form-label">Car Model</label>
                        <input type="text" class="form-control" id="carModel-@Model.CarId" name="CarModel" value="@Model.CarModel" required />
                    </div>

                    <div class="mb-3">
                        <label for="rentPrice-@Model.CarId" class="form-label">Rent Price Per Day</label>
                        <input type="number" class="form-control" id="rentPrice-@Model.CarId" name="RentPricePerDay" value="@Model.RentPricePerDay" required />
                    </div>

                    <div class="mb-3">
                        <label for="carDescription-@Model.CarId" class="form-label">Description</label>
                        <textarea class="form-control" id="carDescription-@Model.CarId" name="CarDescription" rows="3" required>@Model.CarDescription</textarea>
                    </div>

                    <div class="mb-3">
                        <label for="carImage-@Model.CarId" class="form-label">Car Image URL</label>
                        <input type="text" class="form-control" id="carImage-@Model.CarId" name="CarImage" value="@Model.CarImage" required />
                    </div>

                    <div class="form-check mb-3">
                        <input type="hidden" name="IsAvailable" value="false" />
                        <input class="form-check-input" type="checkbox" id="IsAvailable-@Model.CarId" name="IsAvailable" value="true" @(Model.IsAvailable ? "checked" : "") />
                        <label class="form-check-label" for="IsAvailable-@Model.CarId">
                            Available for Rent
                        </label>
                    </div>


                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
