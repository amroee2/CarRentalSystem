@model CarListViewModel

@{
    ViewData["Title"] = "Home Page";
}
@if (TempData["ErrorMessage"] != null)
{
        <div class="alert alert-danger">
        @TempData["ErrorMessage"]
        </div>
}
<div class="container mt-4">
    <h1 class="text-center">Our Cars</h1>
    <div class="row">
        @foreach (var car in Model.Cars)
        {
            @await Html.PartialAsync("_CarCard", car)
        }

        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm d-flex align-items-center justify-content-center"
                     style="cursor: pointer; border: 2px dashed #0d6efd;"
                     data-bs-toggle="modal" data-bs-target="#createCarModal">
                    <div class="text-center">
                        <i class="bi bi-plus-circle" style="font-size: 4rem; color: #0d6efd;"></i>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<div class="modal fade" id="createCarModal" tabindex="-1" aria-labelledby="createCarModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createCarModalLabel">Add New Car</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-controller="Car" asp-action="Create" method="post">
                    <div class="mb-3">
                        <label for="carName" class="form-label">Car Name</label>
                        <input type="text" class="form-control" id="carName" name="CarName" required />
                    </div>

                    <div class="mb-3">
                        <label for="carModel" class="form-label">Car Model</label>
                        <input type="text" class="form-control" id="carModel" name="CarModel" required />
                    </div>

                    <div class="mb-3">
                        <label for="rentPrice" class="form-label">Rent Price Per Day</label>
                        <input type="number" class="form-control" id="rentPrice" name="RentPricePerDay" required />
                    </div>

                    <div class="mb-3">
                        <label for="carDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="carDescription" name="CarDescription" rows="3" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="carImage" class="form-label">Car Image URL</label>
                        <input type="text" class="form-control" id="carImage" name="CarImage" required />
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="IsAvailable" name="IsAvailable" value="true">
                        <label class="form-check-label" for="IsAvailable">Available for Rent</label>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Add Car</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
