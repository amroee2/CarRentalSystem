@model List<User>
@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>
                    <button class="btn btn-info btn-sm" >View More Info</button>
                    <button class="btn btn-success btn-sm">View Rentals</button>
                    <a asp-controller="Cart" asp-action="Summary" asp-route-userId="@user.Id">
                        <button class="btn btn-warning btn-sm">View Carts</button>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
