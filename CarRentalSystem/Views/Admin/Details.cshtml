@model User

@{
    ViewData["Title"] = "User Information";
}

<h1>User Information</h1>

<div class="user-info">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Field</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Username</td>
                <td>@Model.UserName</td>
            </tr>
            <tr>
                <td>Email</td>
                <td>@Model.Email</td>
            </tr>
            <tr>
                <td>Phone Number</td>
                <td>@Model.PhoneNumber</td>
            </tr>
            <tr>
                <td>First Name</td>
                <td>@Model.FirstName</td>
            </tr>
            <tr>
                <td>Last Name</td>
                <td>@Model.LastName</td>
            </tr>
            <tr>
                <td>Primary Address</td>
                <td>@Model.PrimaryAddress</td>
            </tr>
            <tr>
                <td>Secondary Address</td>
                <td>@Model.SecondaryAddress</td>
            </tr>
            <tr>
                <td>City</td>
                <td>@Model.City</td>
            </tr>
            <tr>
                <td>Country</td>
                <td>@Model.Country</td>
            </tr>
            <tr>
                <td>Driver's License Number</td>
                <td>@Model.DriversLicenseNumber</td>
            </tr>
        </tbody>
    </table>
</div>