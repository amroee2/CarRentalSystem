@model List<Cart>

<div class="container mt-5">
    <h2 class="mb-4">Cart Summary</h2>

    @if (Model.Any())
    {
        foreach (var cart in Model)
        {
            <div class="cart-summary mb-4">
                <h4>Cart ID: @cart.CartId</h4>
                <p><strong>Checked Out:</strong> @(cart.IsCheckedOut ? cart.CheckedOutDate.ToString("yyyy-MM-dd") : "No")</p>
                <ul class="list-group">
                    @foreach (var item in cart.CartItems)
                    {
                        <li class="list-group-item">
                            <strong>Car Name:</strong> @item.Car.CarName <br />
                            <strong>Rental Period:</strong> @item.RentalStart.ToString("yyyy-MM-dd") - @item.RentalEnd.ToString("yyyy-MM-dd") <br />
                            <strong>Cost:</strong> $@item.Cost
                        </li>
                    }
                </ul>
                <p class="mt-3"><strong>Total Cost:</strong> $@cart.TotalCost</p>
                <hr class="my-4" />
            </div>
        }
    }
    else
    {
        <p>Your cart is empty.</p>
    }
</div>
